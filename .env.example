AIPRO_API_KEY=your_aipro_api_key
# Optional: change this only if AI PRO uses a different image model name for your account.
AIPRO_IMAGE_MODEL=gpt-image-2
# Native builds cannot call the local SvelteKit route. Point this to the deployed route.
VITE_STYLIZE_API_URL=https://your-domain.example/api/stylize
# Optional production restriction. The prototype defaults to all origins.
AIPRO_ALLOWED_ORIGIN=*
